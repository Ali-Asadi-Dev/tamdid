    "%@ a month together. Could one of them go?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ شهريًا معًا. هل يمكن الاستغناء عن أحدها؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammen %1$@ pro Monat. Kann eins davon weg?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی هم %1$@ در ماه. شاید یکی‌شان لازم نباشد؟"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam ayda %1$@. Biri gidebilir mi?"
          }
        }
      }
    },
