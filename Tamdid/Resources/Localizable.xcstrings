    "A new price applies from today. Earlier payments keep the old price.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبّق السعر الجديد من اليوم، وتبقى الدفعات السابقة بالسعر القديم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Preis gilt ab heute. Frühere Zahlungen behalten den alten Preis."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت جدید از امروز اعمال می‌شود و پرداخت‌های قبلی با قیمت قبلی حساب می‌شوند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni fiyat bugünden itibaren geçerli. Önceki ödemeler eski fiyatla kalır."
          }
        }
      }
    },
