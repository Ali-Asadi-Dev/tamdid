    "Add a few subscriptions to see where your money goes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف بعض الاشتراكات لترى أين تذهب أموالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein paar Abos hinzu, um zu sehen, wohin dein Geld geht."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چند اشتراک اضافه کن تا ببینی پولت کجا می‌رود."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranın nereye gittiğini görmek için birkaç abonelik ekle."
          }
        }
      }
    },
