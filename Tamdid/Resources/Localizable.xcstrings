    "Add the services you pay for to see your monthly total and get reminders.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الخدمات التي تدفع مقابلها لترى إجماليك الشهري وتحصل على تذكيرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Dienste hinzu, für die du zahlst, um deine Monatssumme zu sehen und Erinnerungen zu bekommen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس‌هایی که برایشان پول می‌دهی را اضافه کن تا جمع ماهانه را ببینی و یادآوری بگیری."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık toplamını görmek ve hatırlatma almak için ödediğin hizmetleri ekle."
          }
        }
      }
    },
