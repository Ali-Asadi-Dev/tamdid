{
  "_about": "Shared business-rule fixtures. Both the Swift (TamdidKit) and Kotlin (android/core) test suites load this file, so the two apps cannot drift apart. Dates are ISO-8601 calendar dates.",
  "nextRenewal": [
    {
      "name": "month-end clamps to February",
      "start": "2026-01-31",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-02-01",
      "status": "active",
      "expected": "2026-02-28"
    },
    {
      "name": "month-end recovers to 31st",
      "start": "2026-01-31",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-03-01",
      "status": "active",
      "expected": "2026-03-31"
    },
    {
      "name": "leap February",
      "start": "2024-01-31",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2024-02-01",
      "status": "active",
      "expected": "2024-02-29"
    },
    {
      "name": "renewal day itself counts",
      "start": "2026-03-15",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-03-15",
      "status": "active",
      "expected": "2026-03-15"
    },
    {
      "name": "before start returns first charge",
      "start": "2026-03-15",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-01-01",
      "status": "active",
      "expected": "2026-03-15"
    },
    {
      "name": "yearly from Feb 29 in common year",
      "start": "2024-02-29",
      "unit": "year",
      "interval": 1,
      "onOrAfter": "2025-01-01",
      "status": "active",
      "expected": "2025-02-28"
    },
    {
      "name": "yearly from Feb 29 back in leap year",
      "start": "2024-02-29",
      "unit": "year",
      "interval": 1,
      "onOrAfter": "2028-01-01",
      "status": "active",
      "expected": "2028-02-29"
    },
    {
      "name": "weekly",
      "start": "2026-11-02",
      "unit": "week",
      "interval": 1,
      "onOrAfter": "2026-11-20",
      "status": "active",
      "expected": "2026-11-23"
    },
    {
      "name": "every 3 months",
      "start": "2026-01-15",
      "unit": "month",
      "interval": 3,
      "onOrAfter": "2026-05-01",
      "status": "active",
      "expected": "2026-07-15"
    },
    {
      "name": "every 10 days",
      "start": "2026-11-01",
      "unit": "day",
      "interval": 10,
      "onOrAfter": "2026-11-20",
      "status": "active",
      "expected": "2026-11-21"
    },
    {
      "name": "trial: first charge on trial end",
      "start": "2026-11-01",
      "trialEnd": "2026-11-08",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-11-02",
      "status": "active",
      "expected": "2026-11-08"
    },
    {
      "name": "trial: renews monthly from trial end",
      "start": "2026-11-01",
      "trialEnd": "2026-11-08",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-11-09",
      "status": "active",
      "expected": "2026-12-08"
    },
    {
      "name": "cancelled: still charges before cancellation",
      "start": "2026-01-10",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-05-01",
      "status": "cancelled",
      "expected": "2026-05-10",
      "endDate": "2026-06-01"
    },
    {
      "name": "cancelled: nothing after cancellation",
      "start": "2026-01-10",
      "unit": "month",
      "interval": 1,
      "onOrAfter": "2026-05-20",
      "status": "cancelled",
      "expected": null,
      "endDate": "2026-06-01"
    },
    {
      "name": "paused: no renewal",
      "start": "2026-01-10",
      "unit": "month",
      "interval": 1,
      "status": "paused",
      "onOrAfter": "2026-05-01",
      "expected": null,
      "endDate": "2026-04-15"
    },
    {
      "name": "biweekly across year end",
      "start": "2026-12-21",
      "unit": "week",
      "interval": 2,
      "onOrAfter": "2026-12-22",
      "status": "active",
      "expected": "2027-01-04"
    }
  ],
  "charges": [
    {
      "name": "monthly from the 31st over half a year",
      "start": "2026-01-31",
      "unit": "month",
      "interval": 1,
      "from": "2026-01-01",
      "to": "2026-06-30",
      "status": "active",
      "expected": [
        "2026-01-31",
        "2026-02-28",
        "2026-03-31",
        "2026-04-30",
        "2026-05-31",
        "2026-06-30"
      ]
    },
    {
      "name": "weekly window",
      "start": "2026-11-02",
      "unit": "week",
      "interval": 1,
      "from": "2026-11-10",
      "to": "2026-11-30",
      "status": "active",
      "expected": [
        "2026-11-16",
        "2026-11-23",
        "2026-11-30"
      ]
    },
    {
      "name": "yearly over four years",
      "start": "2020-05-05",
      "unit": "year",
      "interval": 1,
      "from": "2020-01-01",
      "to": "2023-12-31",
      "status": "active",
      "expected": [
        "2020-05-05",
        "2021-05-05",
        "2022-05-05",
        "2023-05-05"
      ]
    },
    {
      "name": "trial delays first charge",
      "start": "2026-01-01",
      "trialEnd": "2026-01-15",
      "unit": "month",
      "interval": 1,
      "from": "2026-01-01",
      "to": "2026-03-31",
      "status": "active",
      "expected": [
        "2026-01-15",
        "2026-02-15",
        "2026-03-15"
      ]
    },
    {
      "name": "cancellation day is inclusive",
      "start": "2026-01-10",
      "unit": "month",
      "interval": 1,
      "from": "2026-01-01",
      "to": "2026-12-31",
      "status": "cancelled",
      "expected": [
        "2026-01-10",
        "2026-02-10",
        "2026-03-10"
      ],
      "endDate": "2026-03-10"
    },
    {
      "name": "window before start is empty",
      "start": "2026-06-01",
      "unit": "month",
      "interval": 1,
      "from": "2026-01-01",
      "to": "2026-05-31",
      "status": "active",
      "expected": []
    }
  ],
